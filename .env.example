# ==============================================================================
# Binary Minds - Environment Configuration
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# In Vite client-side applications, variables prefixed with `VITE_` are bundled
# directly into the compiled JavaScript and ARE VISIBLE TO ANY WEBSITE VISITOR.
#
# NEVER put private API secrets, write tokens, or database passwords in this file!
# ==============================================================================

# Sanity CMS Configuration (Public Read-Only)
# Project ID: 94wv2qdl (Configured in Sanity manage dashboard)
VITE_SANITY_PROJECT_ID=94wv2qdl
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2023-05-03

# Google Apps Script Webhook Endpoint (Optional - for contribution submissions)
VITE_APPS_SCRIPT_URL=

# Build In Public Admin Authentication
# Recommended: Set VITE_BIP_ADMIN_PASSCODE_HASH to the SHA-256 hexadecimal hash
# of your passcode so plaintext passwords are never bundled.
# Example: echo -n "MySecretPass" | sha256sum
VITE_BIP_ADMIN_PASSCODE_HASH=
# Legacy fallback (plaintext):
VITE_BIP_ADMIN_PASSCODE=
